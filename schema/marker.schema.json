{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/ThomasRedstone/media-time-markers/main/schema/marker.schema.json",
  "title": "Media time marker file",
  "type": "object",
  "required": ["acoustid", "duration_ms", "schema_version", "markers"],
  "additionalProperties": false,
  "properties": {
    "acoustid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "AcoustID UUID, lowercase, as returned by api.acoustid.org lookup."
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Track duration in milliseconds, from the fingerprinted file. Used to sanity-check marker offsets."
    },
    "schema_version": {
      "const": 1
    },
    "markers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/marker" }
    }
  },
  "definitions": {
    "marker": {
      "type": "object",
      "required": ["kind", "start_ms"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$",
          "description": "Namespaced marker kind, e.g. skip/lead_silence. See KINDS.md."
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Omit for a point-in-time marker (e.g. sample/wilhelm-scream)."
        },
        "label": {
          "type": "string",
          "maxLength": 140,
          "description": "Optional free-text note, e.g. which variant of a sample."
        },
        "source": {
          "type": "string",
          "description": "Provenance, e.g. manual, plugin:silence-detect, plugin:acoustid-lookup."
        },
        "votes": {
          "type": "integer",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
